              "Value #MEM_AVG": 4,
              "Value #MEM_P95": 5,
              "Value #MEM_MAX": 6,
              "Value #DISK_READ_AVG": 7,
              "Value #DISK_WRITE_AVG": 8,
              "Value #DISK_WRITE_MAX": 9,
              "Value #NET_RX_AVG": 10,
              "Value #NET_TX_AVG": 11,
              "Value #NET_TX_MAX": 12
            },
            "renameByName": {
              "pod": "Pod",
              "Value #CPU_AVG": "CPU Ø (m)",
              "Value #CPU_P95": "CPU P95 (m)",
              "Value #CPU_MAX": "CPU Max (m)",
              "Value #MEM_AVG": "Mem Ø (MiB)",
              "Value #MEM_P95": "Mem P95 (MiB)",
              "Value #MEM_MAX": "Mem Max (MiB)",
              "Value #DISK_READ_AVG": "Disk Read Ø (MiB/s)",
              "Value #DISK_WRITE_AVG": "Disk Write Ø (MiB/s)",
              "Value #DISK_WRITE_MAX": "Disk Write Max (MiB/s)",
              "Value #NET_RX_AVG": "Net RX Ø (MiB/s)",
              "Value #NET_TX_AVG": "Net TX Ø (MiB/s)",
              "Value #NET_TX_MAX": "Net TX Max (MiB/s)"
            }
          }
        }
      ],
      "title": "Ressourcen-Statistik pro Komponente (Avg, P95, Max)",
