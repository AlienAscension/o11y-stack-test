          "legendFormat": "{{pod}}",
          "refId": "MEM_P95",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time((sum by (pod) (container_memory_working_set_bytes{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}) / 1024 / 1024)[$__range:])",
          "legendFormat": "{{pod}}",
          "refId": "MEM_MAX",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time((sum by (pod) (rate(container_fs_reads_bytes_total{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}[5m])) / 1024 / 1024)[$__range:])",
          "legendFormat": "{{pod}}",
          "refId": "DISK_READ_AVG",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time((sum by (pod) (rate(container_fs_writes_bytes_total{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}[5m])) / 1024 / 1024)[$__range:])",
          "legendFormat": "{{pod}}",
          "refId": "DISK_WRITE_AVG",
