    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Ressourcenverbrauch-Übersicht aller Komponenten mit statistischen Werten (Durchschnitt, P95, Maximum) über den ausgewählten Zeitbereich. Diese Tabelle kann direkt für Baseline-Dokumentation exportiert werden.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "id": 7,
      "options": {
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Pod",
            "desc": false
          }
        ]
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time((sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}[5m])) * 1000)[$__range:])",
          "legendFormat": "{{pod}}",
          "refId": "CPU_AVG",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "quantile_over_time(0.95, (sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}[5m])) * 1000)[$__range:])",
          "legendFormat": "{{pod}}",
          "refId": "CPU_P95",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time((sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}[5m])) * 1000)[$__range:])",
          "legendFormat": "{{pod}}",
          "refId": "CPU_MAX",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time((sum by (pod) (container_memory_working_set_bytes{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}) / 1024 / 1024)[$__range:])",
          "legendFormat": "{{pod}}",
          "refId": "MEM_AVG",
          "instant": true
