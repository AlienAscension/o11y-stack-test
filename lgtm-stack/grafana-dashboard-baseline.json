          "legendFormat": "{{pod}}",
          "refId": "NET_RX_AVG",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time((sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"observability-lgtm\"}[5m])) / 1024 / 1024)[$__range:])",
          "legendFormat": "{{pod}}",
          "refId": "NET_TX_AVG",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time((sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"observability-lgtm\"}[5m])) / 1024 / 1024)[$__range:])",
          "legendFormat": "{{pod}}",
          "refId": "NET_TX_MAX",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": {
            "byField": "pod"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
