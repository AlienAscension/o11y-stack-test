            "indexByName": {
              "pod": 0,
              "Value #CPU_AVG": 1,
              "Value #CPU_P95": 2,
              "Value #CPU_MAX": 3,
              "Value #MEM_AVG": 4,
              "Value #MEM_P95": 5,
              "Value #MEM_MAX": 6,
              "Value #DISK_READ_AVG": 7,
              "Value #DISK_WRITE_AVG": 8,
              "Value #DISK_WRITE_MAX": 9,
              "Value #NET_RX_AVG": 10,
              "Value #NET_TX_AVG": 11,
              "Value #NET_TX_MAX": 12
            },
            "renameByName": {
              "pod": "Pod",
              "Value #CPU_AVG": "CPU Ø (m)",
              "Value #CPU_P95": "CPU P95 (m)",
              "Value #CPU_MAX": "CPU Max (m)",
              "Value #MEM_AVG": "Mem Ø (MiB)",
              "Value #MEM_P95": "Mem P95 (MiB)",
