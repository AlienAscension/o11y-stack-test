      "id": 7,
      "options": {
        "footer": {
          "show": true,
          "reducer": ["sum"],
          "fields": ""
        },
        "showHeader": true,
        "sortBy": [{ "displayName": "CPU Ø (m)", "desc": true }]
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg_over_time((sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}[5m])) * 1000)[$stats_window:1m])",
