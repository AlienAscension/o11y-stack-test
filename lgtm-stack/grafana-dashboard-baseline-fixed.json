          "legendFormat": "{{pod}}",
          "refId": "DISK_WRITE_AVG",
          "format": "table",
          "instant": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max_over_time((sum by (pod) (rate(container_fs_writes_bytes_total{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}[5m])) / 1024 / 1024)[$stats_window:1m])",
