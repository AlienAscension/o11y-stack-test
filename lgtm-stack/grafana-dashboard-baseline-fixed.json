      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(container_memory_working_set_bytes{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}) / 1024 / 1024",
          "refId": "A"
        }
      ],
      "title": "Gesamt Memory (Namespace)",
      "type": "stat"
