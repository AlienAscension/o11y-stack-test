        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg_over_time((sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"observability-lgtm\"}[5m])) / 1024 / 1024)[$stats_window:1m])",
          "legendFormat": "{{pod}}",
          "refId": "NET_TX_AVG",
