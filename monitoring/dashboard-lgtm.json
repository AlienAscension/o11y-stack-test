      "title": "Baseline Statistiken (Export für LaTeX) - Zeitfenster: $stats_window",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Ressourcenverbrauch-Übersicht mit statistischen Werten über $stats_window. WICHTIG: Für aussagekräftige Werte mindestens 30 Min Daten sammeln!",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "footer": {
              "reducers": [
                "sum"
              ]
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "CPU Ø (m)"
          }
        ]
      },
      "pluginVersion": "12.3.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time((sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}[5m])) * 1000)[$stats_window:1m])",
          "format": "table",
          "instant": true,
          "legendFormat": "{{pod}}",
          "refId": "CPU_AVG"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "quantile_over_time(0.95, (sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}[5m])) * 1000)[$stats_window:1m])",
          "format": "table",
          "instant": true,
          "legendFormat": "{{pod}}",
          "refId": "CPU_P95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time((sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}[5m])) * 1000)[$stats_window:1m])",
          "format": "table",
          "instant": true,
          "legendFormat": "{{pod}}",
          "refId": "CPU_MAX"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time((sum by (pod) (container_memory_working_set_bytes{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}) / 1024 / 1024)[$stats_window:1m])",
          "format": "table",
          "instant": true,
          "legendFormat": "{{pod}}",
          "refId": "MEM_AVG"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "quantile_over_time(0.95, (sum by (pod) (container_memory_working_set_bytes{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}) / 1024 / 1024)[$stats_window:1m])",
          "format": "table",
          "instant": true,
          "legendFormat": "{{pod}}",
          "refId": "MEM_P95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time((sum by (pod) (container_memory_working_set_bytes{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}) / 1024 / 1024)[$stats_window:1m])",
          "format": "table",
          "instant": true,
          "legendFormat": "{{pod}}",
          "refId": "MEM_MAX"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time((sum by (pod) (rate(container_fs_reads_bytes_total{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}[5m])) / 1024 / 1024)[$stats_window:1m])",
          "format": "table",
          "instant": true,
          "legendFormat": "{{pod}}",
          "refId": "DISK_READ_AVG"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time((sum by (pod) (rate(container_fs_writes_bytes_total{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}[5m])) / 1024 / 1024)[$stats_window:1m])",
          "format": "table",
          "instant": true,
          "legendFormat": "{{pod}}",
          "refId": "DISK_WRITE_AVG"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time((sum by (pod) (rate(container_fs_writes_bytes_total{namespace=\"observability-lgtm\", container!=\"\", container!=\"POD\"}[5m])) / 1024 / 1024)[$stats_window:1m])",
          "format": "table",
          "instant": true,
          "legendFormat": "{{pod}}",
          "refId": "DISK_WRITE_MAX"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time((sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"observability-lgtm\"}[5m])) / 1024 / 1024)[$stats_window:1m])",
          "format": "table",
          "instant": true,
          "legendFormat": "{{pod}}",
          "refId": "NET_RX_AVG"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time((sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"observability-lgtm\"}[5m])) / 1024 / 1024)[$stats_window:1m])",
          "format": "table",
